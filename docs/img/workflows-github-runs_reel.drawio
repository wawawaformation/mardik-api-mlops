<mxfile host="drawio"><diagram id="workflows-runs" name="Workflows GitHub — runs"><mxGraphModel dx="2000" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2020" pageHeight="1265" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titre" value="&lt;b&gt;Les 5 workflows GitHub — ce que fait un run&lt;/b&gt; (état au 2026-09-25, sans le code)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="5" width="1940" height="30" as="geometry"/></mxCell><mxCell id="bandeau" value="&lt;b&gt;Parcours d'un changement :&lt;/b&gt; ① push sur &lt;code&gt;feature/x&lt;/code&gt; → &lt;b&gt;ci.yml&lt;/b&gt; (et &lt;b&gt;alerte-eval.yml&lt;/b&gt; si le push touche un chemin sensible) &amp;nbsp;② PR vers &lt;code&gt;dev&lt;/code&gt; approuvée → &lt;b&gt;revue.yml&lt;/b&gt; &amp;nbsp;③ le développeur pousse le tag &lt;code&gt;gate/&amp;lt;sha7&amp;gt;&lt;/code&gt; → &lt;b&gt;gate.yml&lt;/b&gt; &amp;nbsp;④ fusion vers &lt;code&gt;main&lt;/code&gt; → &lt;b&gt;cd-main.yml&lt;/b&gt;&lt;br&gt;Chaque workflow « prouve » une étape en posant un tag sur le commit ; le suivant vérifie ce tag avant de dépenser quoi que ce soit." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;spacingLeft=14;fontSize=13;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1940" height="90" as="geometry"/></mxCell><mxCell id="la" value="&lt;b&gt;alerte-eval.yml&lt;/b&gt;&lt;br&gt;Alerte d'évaluation — à part" style="swimlane;startSize=52;html=1;whiteSpace=wrap;fontSize=13;rounded=0;swimlaneFillColor=#ffffff;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="300" height="960" as="geometry"/></mxCell><mxCell id="a0" value="&lt;b&gt;Quand ?&lt;/b&gt; Un push sur &lt;code&gt;feature/**&lt;/code&gt; qui touche la config du modèle, &lt;code&gt;app/pipeline/&lt;/code&gt;, &lt;code&gt;llm_client.py&lt;/code&gt; ou &lt;code&gt;eval/&lt;/code&gt;&lt;br&gt;&lt;font color='#9a6400'&gt;&lt;b&gt;Payant — vrai modèle Azure&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;spacing=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="la"><mxGeometry x="15" y="62" width="270" height="105" as="geometry"/></mxCell><mxCell id="a1" value="Préparer la machine&lt;br&gt;&lt;i&gt;secrets Azure, proxy, dépendances&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="la"><mxGeometry x="15" y="210" width="270" height="55" as="geometry"/></mxCell><mxCell id="a2" value="Évaluation réelle de v2&lt;br&gt;&lt;i&gt;12 contrats, seuil 0,75&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="la"><mxGeometry x="15" y="295" width="270" height="55" as="geometry"/></mxCell><mxCell id="a3" value="Écrire la note dans le&lt;br&gt;résumé du run (onglet &lt;i&gt;Summary&lt;/i&gt;)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="la"><mxGeometry x="15" y="380" width="270" height="55" as="geometry"/></mxCell><mxCell id="a4" value="&lt;b&gt;Signal seulement&lt;/b&gt;&lt;br&gt;aucun tag : ne bloque rien,&lt;br&gt;ne prouve rien" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;spacing=6;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="la"><mxGeometry x="15" y="465" width="270" height="65" as="geometry"/></mxCell><mxCell id="a0-a1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a0" target="a1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a1-a2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a2-a3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a3-a4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lc" value="&lt;b&gt;ci.yml&lt;/b&gt;&lt;br&gt;Vérification rapide — lot A" style="swimlane;startSize=52;html=1;whiteSpace=wrap;fontSize=13;rounded=0;swimlaneFillColor=#ffffff;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="390" y="170" width="300" height="960" as="geometry"/></mxCell><mxCell id="c0" value="&lt;b&gt;Quand ?&lt;/b&gt; À chaque push,&lt;br&gt;sur n'importe quelle branche&lt;br&gt;sauf &lt;code&gt;main&lt;/code&gt;&lt;br&gt;&lt;font color='#3d7a2a'&gt;&lt;b&gt;Gratuit — LLM simulé&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;spacing=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lc"><mxGeometry x="15" y="62" width="270" height="105" as="geometry"/></mxCell><mxCell id="c1" value="Préparer la machine&lt;br&gt;&lt;i&gt;code, Python 3.11, dépendances&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lc"><mxGeometry x="15" y="210" width="270" height="55" as="geometry"/></mxCell><mxCell id="c2" value="Vérifier le style du code&lt;br&gt;&lt;i&gt;ruff&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lc"><mxGeometry x="15" y="295" width="270" height="55" as="geometry"/></mxCell><mxCell id="c3" value="Tests unitaires, intégration&lt;br&gt;et acceptance, avec un LLM simulé" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lc"><mxGeometry x="15" y="380" width="270" height="55" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Résultat : ✓ ou ✗ sur le commit&lt;/b&gt;&lt;br&gt;pas de tag — relu par revue.yml" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;spacing=6;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="lc"><mxGeometry x="15" y="460" width="270" height="60" as="geometry"/></mxCell><mxCell id="c0-c1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c0" target="c1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c1-c2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c2-c3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c3-c4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lr" value="&lt;b&gt;revue.yml&lt;/b&gt;&lt;br&gt;Preuve de revue — lot B" style="swimlane;startSize=52;html=1;whiteSpace=wrap;fontSize=13;rounded=0;swimlaneFillColor=#ffffff;fillColor=#eeeeee;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="740" y="170" width="380" height="960" as="geometry"/></mxCell><mxCell id="r0" value="&lt;b&gt;Quand ?&lt;/b&gt; Une revue est déposée sur une pull request&lt;br&gt;&lt;font color='#3d7a2a'&gt;&lt;b&gt;Gratuit — aucun appel LLM&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;spacing=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lr"><mxGeometry x="15" y="62" width="350" height="105" as="geometry"/></mxCell><mxCell id="r1" value="Approbation de&lt;br&gt;&lt;b&gt;connarddu16-design&lt;/b&gt;&lt;br&gt;sur une PR vers &lt;code&gt;dev&lt;/code&gt; ?" style="shape=rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="lr"><mxGeometry x="30" y="205" width="210" height="125" as="geometry"/></mxCell><mxCell id="r1n" value="Run sauté&lt;br&gt;rien ne se passe" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;spacing=6;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#555555;fontSize=11;" vertex="1" parent="lr"><mxGeometry x="275" y="240" width="95" height="55" as="geometry"/></mxCell><mxCell id="r2" value="Récupérer le code&lt;br&gt;du commit relu" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lr"><mxGeometry x="15" y="350" width="240" height="50" as="geometry"/></mxCell><mxCell id="r3" value="&lt;b&gt;ci.yml&lt;/b&gt; vert&lt;br&gt;sur ce commit ?&lt;br&gt;&lt;i&gt;attend jusqu'à 10 min&lt;/i&gt;" style="shape=rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="lr"><mxGeometry x="30" y="425" width="210" height="130" as="geometry"/></mxCell><mxCell id="r3n" value="&lt;b&gt;Refus&lt;/b&gt;&lt;br&gt;run rouge,&lt;br&gt;pas de tag" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;spacing=6;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="lr"><mxGeometry x="275" y="460" width="95" height="60" as="geometry"/></mxCell><mxCell id="r4" value="&lt;b&gt;Pose le tag revue-ok/&amp;lt;sha7&amp;gt;&lt;/b&gt;&lt;br&gt;sur le commit relu" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=0;" vertex="1" parent="lr"><mxGeometry x="15" y="580" width="240" height="60" as="geometry"/></mxCell><mxCell id="r0-r1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r0" target="r1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r1-r2" value="oui" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r1" target="r2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r2-r3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r2" target="r3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r3-r4" value="