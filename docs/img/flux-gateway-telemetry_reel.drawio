<mxfile host="drawio"><diagram id="flux-gateway-telemetry" name="Flux gateway + telemetry"><mxGraphModel dx="1400" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1580" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="titre" value="&lt;b&gt;Flux réel d'une requête &lt;code&gt;POST /analyse&lt;/code&gt;&lt;/b&gt; — &lt;code&gt;app/gateway.py&lt;/code&gt; et &lt;code&gt;app/telemetry.py&lt;/code&gt; (état et n° de ligne au 2026-09-25)" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1320" height="30" as="geometry"/></mxCell><mxCell id="lg" value="app/gateway.py — routeur canary" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fontSize=15;fontStyle=1;rounded=0;swimlaneFillColor=#ffffff;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="720" height="1340" as="geometry"/></mxCell><mxCell id="g1" value="Client (Bruno, client web, traffic_sim.py)&lt;br&gt;→ Caddy :8090 (ou app :8000 en direct) → &lt;b&gt;POST /analyse&lt;/b&gt; {texte}" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lg"><mxGeometry x="190" y="50" width="340" height="60" as="geometry"/></mxCell><mxCell id="g2" value="&lt;b&gt;RequeteAnalyse&lt;/b&gt; &lt;font color=&quot;#a0522d&quot;&gt;l.42&lt;/font&gt; valide ?&lt;br&gt;(texte ≥ 20 caractères)" style="shape=rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="lg"><mxGeometry x="260" y="150" width="200" height="110" as="geometry"/></mxCell><mxCell id="g2e" value="&lt;b&gt;422&lt;/b&gt; (FastAPI)&lt;br&gt;aucune Mesure" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="lg"><mxGeometry x="550" y="175" width="150" height="60" as="geometry"/></mxCell><mxCell id="idx" value="ops/registry/&lt;br&gt;index.json&lt;br&gt;&lt;i&gt;relu à chaque requête&lt;/i&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lg"><mxGeometry x="20" y="300" width="150" height="90" as="geometry"/></mxCell><mxCell id="g3" value="&lt;b&gt;analyse()&lt;/b&gt; &lt;font color=&quot;#a0522d&quot;&gt;l.70&lt;/font&gt;&lt;br&gt;active = &lt;b&gt;registry.active()&lt;/b&gt; &lt;font color=&quot;#a0522d&quot;&gt;registry:121&lt;/font&gt;&lt;br&gt;canary, % = &lt;b&gt;registry.canary()&lt;/b&gt; &lt;font color=&quot;#a0522d&quot;&gt;registry:124&lt;/font&gt;&lt;br&gt;% ← CANARY_PERCENT si défini (.env)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lg"><mxGeometry x="190" y="300" width="340" height="90" as="geometry"/></mxCell><mxCell id="g4" value="&lt;b&gt;choisir_version()&lt;/b&gt; &lt;font color=&quot;#a0522d&quot;&gt;l.47&lt;/font&gt;&lt;br&gt;canary déployé&lt;br&gt;et tirage &amp;lt; % ?&lt;br&gt;&lt;i&gt;tirage = random.uniform(0, 100)&lt;/i&gt;" style="shape=rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="lg"><mxGeometry x="225" y="430" width="270" height="140" as="geometry"/></mxCell><mxCell id="g4a" value="version = canary" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lg"><mxGeometry x="550" y="472" width="150" height="55" as="geometry"/></mxCell><mxCell id="g4b" value="version = active" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lg"><mxGeometry x="20" y="472" width="150" height="55" as="geometry"/></mxCell><mxCell id="g5" value="&lt;b&gt;registry.bundle(version)&lt;/b&gt; &lt;font color=&quot;#a0522d&quot;&gt;registry:104&lt;/font&gt;&lt;br&gt;client = &lt;b&gt;LLMClient(bundle)&lt;/b&gt; &lt;font color=&quot;#a0522d&quot;&gt;llm_client.py:168&lt;/font&gt;&lt;br&gt;&lt;i&gt;bundle livré, pas models/&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lg"><mxGeometry x="190" y="615" width="340" height="70" as="geometry"/></mxCell><mxCell id="g6" value="&lt;b&gt;bundle.strategie&lt;/b&gt; ?" style="shape=rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="lg"><mxGeometry x="260" y="725" width="200" height="100" as="geometry"/></mxCell><mxCell id="g6a" value="&lt;b&gt;analyser_v1()&lt;/b&gt;&lt;br&gt;app/api_v1.py &lt;font color=&quot;#a0522d&quot;&gt;:54&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;spacing=6;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="lg"><mxGeometry x="20" y="855" width="190" height="60" as="geometry"/></mxCell><mxCell id="g6b" value="&lt;b&gt;analyser_v2()&lt;/b&gt;&lt;br&gt;app/api_v2.py &lt;font color=&quot;#a0522d&quot;&gt;:114&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;spacing=6;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="lg"><mxGeometry x="510" y="855" width="190" height="60" as="geometry"/></mxCell><mxCell id="g7" value="issue de&lt;br&gt;l'analyse ?" style="shape=rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="lg"><mxGeometry x="260" y="960" width="200" height="100" as="geometry"/></mxCell><mxCell id="g7a" value="&lt;b&gt;413&lt;/b&gt;&lt;br&gt;DocumentTropLong&lt;br&gt; &lt;font color=&quot;#a0522d&quot;&gt;api_v2.py:53&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="lg"><mxGeometry x="20" y="978" width="160" height="64" as="geometry"/></mxCell><mxCell id="g7b" value="&lt;b&gt;503&lt;/b&gt;&lt;br&gt;ErreurLLM&lt;br&gt; &lt;font color=&quot;#a0522d&quot;&gt;llm_client.py:57&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="lg"><mxGeometry x="540" y="978" width="160" height="64" as="geometry"/></mxCell><mxCell id="g8" value="response.headers[&lt;b&gt;&quot;X-Mardik-Version&quot;&lt;/b&gt;] = version" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="lg"><mxGeometry x="190" y="1110" width="340" height="50" as="geometry"/></mxCell><mxCell id="g9" value="&lt;b&gt;200&lt;/b&gt; + résultat de la version choisie" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="lg"><mxGeometry x="235" y="1210" width="250" height="50" as="geometry"/></mxCell><mxCell id="gnote" value="Injectés par FastAPI : &lt;b&gt;get_registry()&lt;/b&gt; &lt;font color=&quot;#a0522d&quot;&gt;l.55&lt;/font&gt; → Registry() &lt;font color=&quot;#a0522d&quot;&gt;registry:43&lt;/font&gt;, &lt;b&gt;get_telemetry()&lt;/b&gt; &lt;font color=&quot;#a0522d&quot;&gt;l.59&lt;/font&gt; → build_default_telemetry().&lt;br&gt;&lt;b&gt;etat()&lt;/b&gt; &lt;font color=&quot;#a0522d&quot;&gt;l.64&lt;/font&gt; (GET /gateway/etat) relit le même index.json." style="text;html=1;whiteSpace=wrap;align=left;fontSize=11;fontColor=#333333;" vertex="1" parent="lg"><mxGeometry x="20" y="1280" width="680" height="45" as="geometry"/></mxCell><mxCell id="lt" value="app/telemetry.py — traces, logs, métriques" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fontSize=15;fontStyle=1;rounded=0;swimlaneFillColor=#ffffff;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="800" y="40" width="560" height="1340" as="geometry"/></mxCell><mxCell id="tnote" value="Trois primitives regroupées dans l'objet &lt;b&gt;Telemetry&lt;/b&gt; &lt;font color=&quot;#a0522d&quot;&gt;l.112&lt;/font&gt; :&lt;br&gt;• &lt;b&gt;tracer&lt;/b&gt; OpenTelemetry — spans d'une requête ;&lt;br&gt;• &lt;b&gt;logger&lt;/b&gt; structlog — logs JSON ;&lt;br&gt;• &lt;b&gt;metriques&lt;/b&gt; (&lt;b&gt;MetricsStore&lt;/b&gt; &lt;font color=&quot;#a0522d&quot;&gt;l.69&lt;/font&gt;) — une ligne par requête servie, relue par le tableau de bord et le pilotage." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;" vertex="1" parent="lt"><mxGeometry x="20" y="70" width="520" height="110" as="geometry"/></mxCell><mxCell id="grp1" value="① Construction — une seule fois (singleton _defaut)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#4d7a3a;" vertex="1" parent="lt"><mxGeometry x="20" y="265" width="520" height="360" as="geometry"/></mxCell><mxCell id="t1" value="&lt;b&gt;build_default_telemetry()&lt;/b&gt; &lt;font color=&quot;#a0522d&quot;&gt;l.140&lt;/font&gt;&lt;br&gt;renvoie _defaut s'il existe déjà" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lt"><mxGeometry x="130" y="313" width="300" height="65" as="geometry"/></mxCell><mxCell id="t2" value="&lt;b&gt;build_telemetry()&lt;/b&gt; &lt;font color=&quot;#a0522d&quot;&gt;l.119&lt;/font&gt;&lt;br&gt;&lt;b&gt;configure_logging()&lt;/b&gt; &lt;font color=&quot;#a0522d&quot;&gt;l.35&lt;/font&gt; — structlog JSON&lt;br&gt;TracerProvider + ConsoleSpanExporter&lt;br&gt;(&lt;b&gt;NoopSpanExporter&lt;/b&gt; &lt;font color=&quot;#a0522d&quot;&gt;l.158&lt;/font&gt; si OTEL_TRACES=off)&lt;br&gt;&lt;b&gt;MetricsStore&lt;/b&gt;(METRICS_PATH) &lt;font color=&quot;#a0522d&quot;&gt;l.72&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lt"><mxGeometry x="100" y="415" width="360" height="105" as="geometry"/></mxCell><mxCell id="t3" value="&lt;b&gt;Telemetry&lt;/b&gt;(tracer, logger, metriques) &lt;font color=&quot;#a0522d&quot;&gt;l.112&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lt"><mxGeometry x="130" y="555" width="300" height="45" as="geometry"/></mxCell><mxCell id="grp2" value="② Pendant l'analyse — appelé par analyser_v1() et analyser_v2()" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#4d7a3a;" vertex="1" parent="lt"><mxGeometry x="20" y="665" width="520" height="660" as="geometry"/></mxCell><mxCell id="t4" value="&lt;b&gt;tracer.start_as_current_span()&lt;/b&gt;&lt;br&gt;« analyse.requete » ⊃ « llm.appel »&lt;br&gt;&lt;i&gt;export : console du container&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lt"><mxGeometry x="35" y="710" width="235" height="80" as="geometry"/></mxCell><mxCell id="t5" value="&lt;b&gt;logger.info()&lt;/b&gt; / &lt;b&gt;logger.error()&lt;/b&gt;&lt;br&gt;« analyse.echec »&lt;br&gt;&lt;i&gt;logs JSON (structlog)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lt"><mxGeometry x="290" y="710" width="235" height="80" as="geometry"/></mxCell><mxCell id="t6" value="&lt;b&gt;metriques.enregistrer(Mesure)&lt;/b&gt; &lt;font color=&quot;#a0522d&quot;&gt;l.76&lt;/font&gt; — &lt;b&gt;Mesure&lt;/b&gt; &lt;font color=&quot;#a0522d&quot;&gt;l.51&lt;/font&gt;&lt;br&gt;ts, version, route, latence_ms, erreur,&lt;br&gt;score, cout_eur, appels_llm, tokens, tronque&lt;br&gt;&lt;i&gt;succès, ErreurLLM et DocumentTropLong (erreur=True) — jamais un 422&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lt"><mxGeometry x="60" y="830" width="440" height="95" as="geometry"/></mxCell><mxCell id="t7" value="&lt;b&gt;ops/metrics.jsonl&lt;/b&gt;&lt;br&gt;1 ligne JSON par requête&lt;br&gt;&lt;i&gt;container v2 isolé : metrics_v2.jsonl&lt;/i&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="lt"><mxGeometry x="140" y="990" width="280" height="95" as="geometry"/></mxCell><mxCell id="t8" value="&lt;b&gt;MetricsStore.lire(depuis_s, version)&lt;/b&gt; &lt;font color=&quot;#a0522d&quot;&gt;l.81&lt;/font&gt;&lt;br&gt;filtre par fenêtre de temps et par version" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;spacing=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lt"><mxGeometry x="100" y="1115" width="360" height="60" as="geometry"/></mxCell><mxCell id="t9" value="Lecteurs : &lt;b&gt;resume()&lt;/b&gt; (ops/dashboard.py &lt;font color=&quot;#a0522d&quot;&gt;:59&lt;/font&gt;)&lt;br&gt;&lt;b&gt;lire_dashboard()&lt;/b&gt; &lt;font color=&quot;#a0522d&quot;&gt;:173&lt;/font&gt;, &lt;b&gt;_stats_fenetre()&lt;/b&gt; &lt;font color=&quot;#a0522d&quot;&gt;:248&lt;/font&gt; (ops/serveur_pilotage.py)&lt;br&gt;&lt;b&gt;surveiller()&lt;/b&gt; (ops/deploy.py &lt;font color=&quot;#a0522d&quot;&gt;:169&lt;/font&gt;)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;spacing=6;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="lt"><mxGeometry x="60" y="1210" width="440" height="75" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="g1" target