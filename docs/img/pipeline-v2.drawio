        <!-- ===================== ORCHESTRATEUR ===================== -->
        <mxCell id="orch" value="app/api_v2.py :: analyser_v2(texte, client, telemetry)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1">
