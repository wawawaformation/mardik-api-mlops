        <mxCell id="d1" value="len(texte) >&#10;contexte_max_caracteres ?&#10;(16 000 car.)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="255" width="240" height="150" as="geometry" />
        </mxCell>

        <mxCell id="n1" value="Défaut connu de la v1 : la coupe se&#10;fait AVANT l'appel LLM, sans avertir&#10;— les clauses de fin (résiliation,&#10;pénalités, droit applicable) sont&#10;perdues sur les contrats longs.&#10;C'est la raison d'être de la v2&#10;(aucune troncature)." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#F5F5F5;strokeColor=#666666;fontSize=10;align=left;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="450" y="80" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="an1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#82B366;strokeWidth=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="d1" target="n1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e2" value="app/llm_client.py&#10;LLMClient.completer()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="820" y="280" width="220" height="100" as="geometry" />
        </mxCell>

        <mxCell id="n2" value="MOCK=on (réservé à la CI) : rejoue&#10;eval/fixtures/*.json (clé = empreinte&#10;du prompt), ou reconstruit une&#10;réponse déterministe par mots-clés&#10;si aucune fixture ne correspond.&#10;Sinon : appel réseau réel via&#10;ops/drift_proxy.py (transparent si&#10;DRIFT=off) vers Ollama ou un fournisseur LLM distant." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#F5F5F5;strokeColor=#666666;fontSize=10;align=left;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="780" y="520" width="300" height="190" as="geometry" />
        </mxCell>
        <mxCell id="an2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#82B366;strokeWidth=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="e2" target="n2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="d3" value="appel réussi ?&#10;(réseau réel&#10;uniquement)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1140" y="255" width="220" height="150" as="geometry" />
        </mxCell>

        <mxCell id="e-err" value="ErreurLLM levée&#10;(HTTP, timeout, réponse vide —&#10;jamais si MOCK=on)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="1150" y="560" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="e-terminal" value="Mesure(erreur=True) + log&#10;analyse.echec → HTTP 503&#10;(detail explicite, jamais 500 brut)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="1160" y="710" width="260" height="110" as="geometry" />
        </mxCell>

        <mxCell id="e4" value="app/api_v1.py&#10;_parser_clauses()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=center;" vertex="1" parent="1">
