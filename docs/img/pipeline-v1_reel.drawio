        <!-- ===================== ACTEUR ===================== -->
        <mxCell id="acteur" value="Client v1&#10;(scripts/client_v1.py)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;" vertex="1" parent="1">
