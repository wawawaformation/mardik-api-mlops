        <!-- ===================== FLUX PRINCIPAL ===================== -->
        <mxCell id="e1" value="app/api_v1.py&#10;analyse() → analyser_v1()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=center;" vertex="1" parent="1">
